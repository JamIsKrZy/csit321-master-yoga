    private void HandleReviewSubmit()
    {
        lastSubmittedAuthor = newReview.AuthorName;
        newReview.Id = Guid.NewGuid();
        newReview.CreatedAt = DateTime.Now;
        newReview.HelpfulCount = 0;

        // Insert at the top of the reviews list
        reviews.Insert(0, newReview);

