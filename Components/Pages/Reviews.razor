    private IEnumerable<ReviewModel> FilteredReviews
    {
        get
        {
            if (selectedRatingFilter == 0) return reviews.OrderByDescending(r => r.CreatedAt);
            if (selectedRatingFilter <= 3) return reviews.Where(r => r.Rating <= 3).OrderByDescending(r => r.CreatedAt);
            return reviews.Where(r => r.Rating == selectedRatingFilter).OrderByDescending(r => r.CreatedAt);
        }
